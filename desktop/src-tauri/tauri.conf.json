{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaiZe",
  "version": "0.1.0",
  "identifier": "com.lukaisluka.baize",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "resources/baize": "baize"
    }
  }
}
