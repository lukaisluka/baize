{
  "name": "baize",
  "version": "0.0.1",
  "description": "Local-first multi-repo code Q&A over your GitLab fleet",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukaisluka/baize.git"
  },
  "bin": {
    "baize": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "ui"
  ],
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "build:ui": "npm run build -w ui",
    "test": "node --test 'test/**/*.test.js'",
    "test:ui": "npm run test -w ui"
  },
  "dependencies": {
    "codebase-memory-mcp": "0.10.8",
    "ws": "^8.21.3"
  }
}
